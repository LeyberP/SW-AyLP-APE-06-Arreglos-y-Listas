# =====================================================================
# .gitignore - SW-AyLP-APE-06: Arreglos y Listas
# Excluye documentos de informe, plantillas y archivos compilados
# =====================================================================

# Documentos de informes y guías (Word, PDF, archivos temporales de Word)
*.docx
*.doc
~$*.docx
~$*.doc
*.pdf

# Archivos Markdown temporales del informe (mantener solo los README.md)
Informe_SW-AyLP-APE-06.md
Informe_*.md

# Archivos compilados y empaquetados de Java
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
bin/
out/
target/
build/

# Configuración de IDEs y sistema operativo
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini
